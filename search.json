---
layout: null
---
{%- assign docs = site.posts | concat: site.photography -%}
[
  {%- for doc in docs %}
  {
    "title": {{ doc.title | strip_html | jsonify }},
    "url": {{ doc.url | jsonify }},
    "content": {{ doc.content | strip_html | strip_newlines | strip | jsonify }}
  }{% unless forloop.last %},{% endunless %}
  {%- endfor %}
]
